# Source this in a fresh sandbox:  . dev/env.sh   (copy this file to dev/env.sh and edit; env.sh is git-ignored)
# 1) one-time:  mkdir -p ~/rt && cd ~/rt && npm i @earendil-works/pi-coding-agent@1.5.0     (≈160 MB; pins the measured version)
export RT="${RT:-$HOME/rt}"
export PATH="$RT/node_modules/.bin:$PATH"
export PI_BIN="$RT/node_modules/.bin/pi"
# 2) an isolated agent dir so tests never touch a real ~/.pi/agent
export PI_CODING_AGENT_DIR="${PI_CODING_AGENT_DIR:-$HOME/pinew-test-agent}"
# 3) a mock provider in $PI_CODING_AGENT_DIR/models.json — see dev/README.md for the exact JSON
